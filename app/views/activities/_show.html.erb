<div class="activity-history">
  <h4><%= t "tasks.activities.activities_history" %></h4>
  <ul class="list-group">
    <% @task.activities.order(created_at: :desc).each do |activity| %>
      <li class="list-group-item">
        <strong><%= activity.user.name %></strong>
        <span><%= activity.action%></span>
        - <%= activity.description %>
        <small class="text-muted">(<%= time_ago_in_words(activity.created_at) %> <%= t "common.ago" %>)</small>
      </li>
    <% end %>
  </ul>
