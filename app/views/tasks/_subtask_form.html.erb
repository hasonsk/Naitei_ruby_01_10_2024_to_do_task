<%= form_with model: @task, url: create_subtask_tasks_path(parent_task_id: @task.id), local: true, html: { class: "card shadow-sm" } do |f| %>
  <div class="card-body">
    <h5 class="card-title"><%= t("tasks.new_subtask") %></h5>

    <%= f.fields_for :subtasks do |subtask_fields| %>

      <div class="mb-4">
        <%= subtask_fields.label :title, t("tasks.title"), class: "form-label fw-bold" %>
        <%= subtask_fields.text_field :title, class: "form-control form-control-lg", placeholder: t("tasks.enter_title"), required: true, aria: { label: t("tasks.title") } %>
      </div>

      <div class="mb-4">
        <%= subtask_fields.label :description, t("tasks.description"), class: "form-label fw-bold" %>
        <%= subtask_fields.text_area :description, rows: 4, class: "form-control", placeholder: t("tasks.enter_description"), aria: { label: t("tasks.description") } %>
      </div>

      <div class="row mb-4">
        <div class="col-md-4">
          <%= subtask_fields.label :priority, t("tasks.priority"), class: "form-label fw-bold" %>
          <%= subtask_fields.select :priority, Task.priorities.keys.map { |p| [p.humanize, p] }, { prompt: t("tasks.select_priority") }, required: true, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= subtask_fields.label :status, t("tasks.status"), class: "form-label fw-bold" %>
          <%= subtask_fields.select :status, Task.statuses.keys.map { |s| [s.humanize, s] }, { prompt: t("tasks.select_status") }, required: true, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= subtask_fields.label :category_id, "Select category", class: "form-label fw-bold" %>
          <%= subtask_fields.select :category_id, @categories.map { |c| [c.name, c.id] }, { prompt: "Select a category" }, class: "form-select" %>
        </div>
      </div>

      <div class="mb-4">
        <%= subtask_fields.label :assignee_id, t("tasks.assignee"), class: "form-label fw-bold" %>
        <%= subtask_fields.select :assignee_id, options_from_collection_for_select(@users, :id, :name, @task.assignee_id), { include_blank: t("tasks.select_assignee") }, class: "form-control" %>
      </div>

      <div class="row mb-4">
        <div class="col-md-6">
          <%= subtask_fields.label :start_date, t("tasks.start_date"), class: "form-label fw-bold" %>
          <%= subtask_fields.date_field :start_date, class: "form-control", required: true %>
        </div>
        <div class="col-md-6">
          <%= subtask_fields.label :deadline, t("tasks.deadline"), class: "form-label fw-bold" %>
          <%= subtask_fields.date_field :deadline, class: "form-control", required: true %>
        </div>
      </div>

      <hr class="my-4">

     <% end %>

    <div class="d-flex justify-content-end">
      <%= f.submit t("tasks.save"), class: "btn btn-success btn-lg" %>
    </div>
  </div>
<% end %>
