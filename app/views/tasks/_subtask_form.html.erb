<%= form_with model: @subtask, url: task_subtasks_path(@task), method: :post, html: { class: "new_subtask_form" } do |f| %>
  <div class="card-body">
    <div class="mb-4">
      <%= f.hidden_field :parent_task_id, value: @task.id %>
      <%= f.label :title, t("tasks.title"), class: "form-label fw-bold" %>
      <%= f.text_field :title, class: "form-control form-control-lg", placeholder: t("tasks.enter_title"), required: true, aria: { label: t("tasks.title") } %>
    </div>
    <%= render partial: "shared/form_fields", locals: { f: f, categories: @categories, task: @subtask } %>
  </div>
<% end %>
