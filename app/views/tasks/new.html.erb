<% provide :title, t("tasks.new.title") %>
<h1><%= t("tasks.new.title") %></h1>

<div class="container mt-4">
    <%= link_to t("tasks.back"), tasks_path, class: "btn btn-primary mb-3" %>
    <div class="row">
        <!-- Main Task Form -->
        <div class="col-md-6">
            <%= form_with model: @task, local: true do |f| %>
                <div class="mb-3">
                    <%= f.label :title, t("tasks.title"), class: "form-label" %>
                    <%= f.text_field :title, class: "form-control" %>
                </div>
                <div class="mb-3">
                    <%= f.label :description, t("tasks.description"), class: "form-label" %>
                    <%= f.text_area :description, rows: 3, class: "form-control" %>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <%= f.label :priority, t("tasks.priority"), class: "form-label" %>
                        <%= f.select :priority, Task.priorities.keys.map { |p| [p.humanize, p] }, { prompt: t("tasks.select_priority") }, class: "form-select" %>
                    </div>
                    <div class="col-md-6">
                        <%= f.label :status, t("tasks.status"), class: "form-label" %>
                        <%= f.select :status, Task.statuses.keys.map { |s| [s.humanize, s] }, { prompt: t("tasks.select_status") }, class: "form-select" %>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <%= f.label :start_date, t("tasks.start_date"), class: "form-label" %>
                        <%= f.date_field :start_date, class: "form-control" %>
                    </div>
                    <div class="col-md-6">
                        <%= f.label :end_date, t("tasks.end_date"), class: "form-label" %>
                        <%= f.date_field :end_date, class: "form-control" %>
                    </div>
                </div>
                <div class="mb-3 mt-3">
                    <%= f.label :assignee, t("tasks.assignee"), class: "form-label" %>
                    <%= f.text_field :assignee, class: "form-control" %>
                </div>
                <%= f.submit t("tasks.save"), class: "btn btn-success" %>
            <% end %>
        </div>

        <!-- Subtask Section -->
        <div class="col-md-6">
            <button class="btn btn-secondary mb-3" id="add-subtask"><%= t("tasks.new_subtask") %></button>
            <div id="subtasks-container">
                <!-- Subtasks will be dynamically added here -->
            </div>
        </div>
    </div>
</div>

<template id="subtask-template">
    <div class="card card-subtask">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label"><%= t("tasks.subtask.title") %></label>
                <input type="text" class="form-control" placeholder="<%= t("tasks.subtask.enter_title") %>" required>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label"><%= t("tasks.priority") %></label>
                    <select class="form-select" required>
                        <option value="" disabled selected><%= t("tasks.select_priority") %></option>
                        <option value="low"><%= t("tasks.priority_low") %></option>
                        <option value="medium"><%= t("tasks.priority_medium") %></option>
                        <option value="high"><%= t("tasks.priority_high") %></option>
                        <option value="urgent"><%= t("tasks.priority_urgent") %></option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><%= t("tasks.status") %></label>
                    <select class="form-select" required>
                        <option value="" disabled selected><%= t("tasks.select_status") %></option>
                        <option value="pending"><%= t("tasks.status_pending") %></option>
                        <option value="in_progress"><%= t("tasks.status_in_progress") %></option>
                        <option value="completed"><%= t("tasks.status_completed") %></option>
                        <option value="expired"><%= t("tasks.status_expired") %></option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label"><%= t("tasks.start_date") %></label>
                    <input type="date" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><%= t("tasks.end_date") %></label>
                    <input type="date" class="form-control" required>
                </div>
            </div>
            <div class="mb-3 mt-3">
                <label class="form-label"><%= t("tasks.assignee") %></label>
                <input type="text" class="form-control" required>
            </div>
            <button class="btn btn-primary btn-sm save-subtask"><%= t("tasks.save_subtask") %></button>
        </div>
    </div>
</template>

<template id="subtask-collapsed-template">
    <div class="subtask-collapsed">
        <span class="subtask-title"></span>
        <div class="subtask-details"></div>
        <div class="actions">
            <button class="btn btn-sm btn-outline-primary view-details">👁</button>
            <button class="btn btn-sm btn-outline-danger delete-subtask">🗑</button>
        </div>
    </div>
</template>

<script>
    document.getElementById('add-subtask').addEventListener('click', function () {
        const template = document.getElementById('subtask-template');
        const clone = template.content.cloneNode(true);
        document.getElementById('subtasks-container').appendChild(clone);
    });

    document.getElementById('subtasks-container').addEventListener('click', function (e) {
        if (e.target.classList.contains('save-subtask')) {
            const card = e.target.closest('.card-subtask');
            const titleInput = card.querySelector('input[placeholder="<%= t("tasks.subtask.enter_title") %>"]');
            const priorityInput = card.querySelector('select:nth-of-type(1)');
            const statusInput = card.querySelector('select:nth-of-type(2)');
            const startDateInput = card.querySelector('input[type="date"]:nth-of-type(1)');
            const endDateInput = card.querySelector('input[type="date"]:nth-of-type(2)');

            if (!titleInput.value.trim()) {
                alert('<%= t("tasks.subtask.title_required") %>');
                return;
            }

            const collapsedTemplate = document.getElementById('subtask-collapsed-template');
            const collapsedClone = collapsedTemplate.content.cloneNode(true);
            collapsedClone.querySelector('.subtask-title').textContent = titleInput.value;

            const details = `<%= t("tasks.priority") %>: ${priorityInput.value || '<%= t("tasks.na") %>'}, <%= t("tasks.status") %>: ${statusInput.value || '<%= t("tasks.na") %>'}, <%= t("tasks.deadline") %>: ${endDateInput.value || '<%= t("tasks.na") %>'}`;
            collapsedClone.querySelector('.subtask-details').textContent = details;

            card.replaceWith(collapsedClone);
        }

        if (e.target.classList.contains('delete-subtask')) {
            e.target.closest('.subtask-collapsed').remove();
        }

        if (e.target.classList.contains('view-details')) {
            const card = e.target.closest('.subtask-collapsed');
            const title = card.querySelector('.subtask-title').textContent;
            const details = card.querySelector('.subtask-details').textContent;
            alert(`<%= t("tasks.subtask.details_for") %> ${title}\n${details}`);
        }
    });
</script>
