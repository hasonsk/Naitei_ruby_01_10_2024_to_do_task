<% if logged_in? %>
  <h1><%= t("static_pages.home.title") %></h1>
  <div class="row">
    <aside class="col-md-4">
  </div>
<% else %>
  <div class="center jumbotron">
    <h1><%= t "static_pages.home.welcome" %></h1>
    <%= link_to t("signup"), signup_path, class: "btn btn-lg btn-primary" %>
  </div>
<% end %>
